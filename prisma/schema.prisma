generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Artifact {
  id         String   @id
  userId     String
  workspaceId String   @default("demo-workspace")
  fileName   String
  fileType   String
  mimeType   String
  sizeBytes  Int
  storageUrl String
  storageKey String
  storageVisibility String @default("local-dev")
  status     String
  parserError String?
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  extractedContent ArtifactExtractedContent?
  classification ArtifactClassification?
  sourceRelationships ArtifactRelationship[] @relation("SourceArtifact")
  targetRelationships ArtifactRelationship[] @relation("TargetArtifact")
  evidenceLinks EvidenceLink[]
  parserJobs ParserJob[]

  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([uploadedAt])
}

model ArtifactExtractedContent {
  id            String   @id
  artifactId    String   @unique
  text          String
  parser        String
  parserVersion String
  createdAt     DateTime @default(now())
  artifact      Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
}

model ArtifactClassification {
  id                String   @id
  artifactId        String   @unique
  classification    String
  confidenceScore   Int
  projectName       String?
  courseOrJob       String?
  tools             String[]
  methods           String[]
  dates             String[]
  outcomes          String[]
  tags              String[]
  classifier        String
  classifierVersion String
  createdAt         DateTime @default(now())
  artifact          Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
}

model ProjectCluster {
  id              String   @id
  workspaceId     String   @default("demo-workspace")
  label           String
  artifactIds     String[]
  reasons         String[]
  confidenceScore Int
  status          String
  createdAt       DateTime @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
}

model ArtifactRelationship {
  id               String   @id
  sourceArtifactId String
  targetArtifactId String
  type             String
  reason           String
  confidenceScore  Int
  status           String
  createdAt        DateTime @default(now())
  sourceArtifact   Artifact @relation("SourceArtifact", fields: [sourceArtifactId], references: [id], onDelete: Cascade)
  targetArtifact   Artifact @relation("TargetArtifact", fields: [targetArtifactId], references: [id], onDelete: Cascade)

  @@index([sourceArtifactId])
  @@index([targetArtifactId])
  @@index([status])
}

model User {
  id          String   @id
  email       String?  @unique
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberships WorkspaceMember[]
  auditLogs   AuditLog[]
}

model Workspace {
  id          String   @id
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     WorkspaceMember[]
  artifacts   Artifact[]
  portfolios  Portfolio[]
  projects    Project[]
  parserJobs  ParserJob[]
  auditLogs   AuditLog[]
  clusters    ProjectCluster[]
  portfolioBlueprint PortfolioBlueprint?
  portfolioBlueprintRevisions PortfolioBlueprintRevision[]
  blueprintAuditEvents BlueprintAuditEvent[]
  caseStudyDrafts CaseStudyDraft[]
  caseStudyQualityReports CaseStudyQualityReport[]
  caseStudyRevisions CaseStudyRevision[]
  portfolioPageCompositions PortfolioPageComposition[]
  portfolioExperiencePlans PortfolioExperiencePlan[]
}

model WorkspaceMember {
  id          String @id
  workspaceId String
  userId      String
  role        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Portfolio {
  id          String   @id
  workspaceId String
  ownerId     String?
  slug        String
  title       String
  status      String
  theme       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pages       PortfolioPage[]
  projects    Project[]
  publishRecords PublishRecord[]

  @@unique([workspaceId, slug])
}

model PortfolioPage {
  id          String   @id
  portfolioId String
  type        String
  slug        String
  title       String
  order       Int
  status      String
  contentJson Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, slug])
}

model Project {
  id          String   @id
  workspaceId String
  portfolioId String?
  title       String
  summary     String?
  status      String
  confidenceScore Int?
  sourceClusterId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  portfolio   Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  caseStudies CaseStudy[]
  evidenceLinks EvidenceLink[]

  @@index([workspaceId, status])
}

model CaseStudy {
  id          String   @id
  projectId   String
  title       String
  status      String
  contentJson Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidenceLinks EvidenceLink[]
}

model EvidenceLink {
  id          String   @id
  workspaceId String
  artifactId  String
  projectId   String?
  caseStudyId String?
  claimPath   String?
  quote       String?
  reason      String?
  confidenceScore Int?
  status      String
  createdAt   DateTime @default(now())
  artifact    Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  caseStudy   CaseStudy? @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([artifactId])
  @@index([projectId])
}

model ParserJob {
  id          String   @id
  workspaceId String
  artifactId  String
  type        String
  status      String
  error       String?
  attempts    Int      @default(0)
  outputJson  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artifact    Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([artifactId])
}

model PublishRecord {
  id          String   @id
  portfolioId String
  version     Int
  status      String
  url         String?
  snapshotJson Json
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, version])
}

model AuditLog {
  id          String   @id
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  source      String
  requestId   String?
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}

model PortfolioBlueprint {
  id                 String   @id
  workspaceId        String   @unique
  userId             String
  version            Int
  status             String
  archetype          String
  readinessScore     Int
  blueprintJson      Json
  reviewStateJson    Json
  provenanceRefsJson Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  revisions          PortfolioBlueprintRevision[]
  auditEvents        BlueprintAuditEvent[]

  @@index([userId])
  @@index([status])
}

model PortfolioBlueprintRevision {
  id              String   @id
  blueprintId     String
  workspaceId     String
  version         Int
  snapshotJson    Json
  reviewStateJson Json
  changeSummary   String
  createdBy       String?
  createdAt       DateTime @default(now())
  blueprint       PortfolioBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditEvents     BlueprintAuditEvent[]

  @@unique([blueprintId, version])
  @@index([workspaceId, version])
}

model BlueprintAuditEvent {
  id          String   @id
  workspaceId String
  blueprintId String?
  revisionId  String?
  actorId     String?
  action      String
  beforeJson  Json?
  afterJson   Json?
  source      String
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  blueprint   PortfolioBlueprint? @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  revision    PortfolioBlueprintRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([blueprintId, createdAt])
  @@index([action])
}

model CaseStudyDraft {
  id             String   @id
  workspaceId    String
  blueprintId    String
  blueprintVersion Int
  projectId      String
  title          String
  archetype      String
  status         String
  contentJson    Json
  provenanceRefsJson Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([blueprintId])
  @@index([projectId])
}

model CaseStudyQualityReport {
  id             String   @id
  workspaceId    String
  caseStudyDraftId String
  projectId      String
  readiness      String
  publishRisk    String
  overallScore   Int
  reportJson     Json
  createdAt      DateTime @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([caseStudyDraftId])
  @@index([readiness])
}

model CaseStudyRevision {
  id             String   @id
  workspaceId    String
  draftId        String
  sectionId      String
  status         String
  goal           String
  originalContent String
  revisedContent  String
  changeSummaryJson Json
  qualityDeltaJson Json
  provenanceRefsJson Json
  unsupportedWarnings String[]
  actorId        String?
  decidedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, draftId])
  @@index([draftId, sectionId])
  @@index([status])
}

model PortfolioPageComposition {
  id               String   @id
  workspaceId      String
  caseStudyDraftId String
  projectId        String
  title            String
  archetype        String
  status           String
  compositionJson  Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([caseStudyDraftId])
  @@index([projectId])
  @@index([status])
}

model PortfolioExperiencePlan {
  id          String   @id
  workspaceId String
  blueprintId String?
  archetype   String
  status      String
  planJson    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([blueprintId])
  @@index([status])
}

model PortfolioReference {
  id                    String   @id
  url                   String
  normalizedUrl         String   @unique
  title                 String
  archetype             String
  roleType              String
  portfolioStyle        String
  storytellingStructure String
  layoutStructure       String
  researchWeight        String
  visualWeight          String
  recruiterReadability  String
  technicalDepth        String
  captureStatus         String
  screenshots           Json
  metadata              Json
  reviewTags            String[]
  adminNotes            String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([archetype])
  @@index([portfolioStyle])
  @@index([captureStatus])
  @@index([createdAt])
}
