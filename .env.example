# Auto-CaseStudy local/preview configuration

# Required for production previews that expose /studio or upload APIs.
# When set, /studio, /api/artifacts, and /api/evidence-map require HTTP Basic Auth.
AUTOCASESTUDY_STUDIO_PASSWORD=

# PostgreSQL metadata storage. Local development can omit this and use .data fallback.
DATABASE_URL=

# Vercel Blob token. Source artifacts are sensitive, so uploads fail closed unless
# AUTOCASESTUDY_ALLOW_PUBLIC_ARTIFACT_URLS is explicitly enabled for a demo.
BLOB_READ_WRITE_TOKEN=
AUTOCASESTUDY_ALLOW_PUBLIC_ARTIFACT_URLS=false

# Upload safety limits.
AUTOCASESTUDY_MAX_FILES_PER_REQUEST=5
AUTOCASESTUDY_MAX_FILE_BYTES=15728640
AUTOCASESTUDY_MAX_TOTAL_BYTES=41943040
AUTOCASESTUDY_MAX_SYNC_PARSE_BYTES=8388608
AUTOCASESTUDY_MAX_EXTRACTED_TEXT_CHARS=50000
AUTOCASESTUDY_MAX_PPTX_SLIDES=80
AUTOCASESTUDY_MAX_PPTX_SLIDE_XML_CHARS=250000
