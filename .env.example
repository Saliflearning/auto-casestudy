# PostgreSQL metadata database. Required for production metadata persistence.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Vercel Blob durable file storage. Required for production file persistence.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Temporary single-user fallback until auth exists.
AUTOCASESTUDY_DEFAULT_USER_ID="demo-user"
